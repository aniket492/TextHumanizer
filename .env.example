# Docker Compose settings. Copy to `.env` and fill in real values. Never commit `.env`.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_USER=humanizer
POSTGRES_PASSWORD=
POSTGRES_DB=humanizer
POSTGRES_PORT=5433

JWT_SECRET=

BACKEND_PORT=8000
FRONTEND_PORT=8080
CORS_ORIGINS=http://localhost:8080

# auto | transformers | baseline
MODEL_BACKEND=auto
MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct
# Path inside the container to a fine-tuned model or LoRA adapter, e.g. /app/models/final
MODEL_PATH=
MODEL_DEVICE=cpu
MODEL_PRELOAD=true
