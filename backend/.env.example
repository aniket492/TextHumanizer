# Backend settings for local (non-Docker) runs. Copy to backend/.env. Never commit backend/.env.
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL (docker compose exposes it on localhost:5433)
DATABASE_URL=postgresql+psycopg://humanizer:<password>@localhost:5433/humanizer

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Where the API is reachable (the frontend uses VITE_API_BASE_URL in frontend/.env)
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Rewrite model: auto (model, falls back to rules) | transformers (model required) | baseline (rules only)
MODEL_BACKEND=auto
MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct
# Optional fine-tuned model / LoRA adapter directory (overrides MODEL_NAME), e.g. ../models/final
MODEL_PATH=
MODEL_DEVICE=auto
MODEL_MAX_NEW_TOKENS=384
MODEL_TIMEOUT_SECONDS=90
MODEL_NUM_CANDIDATES=1
MODEL_PRELOAD=false

# Semantic similarity model (empty = TF-IDF fallback, no download)
SIMILARITY_MODEL=sentence-transformers/all-MiniLM-L6-v2

MAX_INPUT_WORDS=1500
MAX_INPUT_CHARS=12000
